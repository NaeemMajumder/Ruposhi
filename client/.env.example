# Public site URL (used for SEO: canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ruposhi API (server folder) base URL. Browsers never call it directly — Next proxies /api/v1/* to it,
# so login cookies stay first-party. Used by server-side rendering too.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Optional tracking IDs (also editable from Admin → Settings → Tracking)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Server-only (NOT NEXT_PUBLIC_) — same value as PROXY_SECRET in the API's env. Leave empty locally.
PROXY_SECRET=
