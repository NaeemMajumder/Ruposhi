# ───────── Ruposhi API — environment ─────────
NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Data source: "memory" (demo JSON data, works offline) or "mongo"
DATA_SOURCE=memory
# MongoDB Atlas connection string — will be provided later
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ruposhi?retryWrites=true&w=majority
# Database name inside the cluster (always used, whatever the URI says). First start on an empty DB adds the demo store.
MONGODB_DB=ruposhi

# Demo mode: OTP codes are returned in API responses, payments/courier/SMS are simulated
DEMO_MODE=true

# Demo OTP code (DEMO_MODE only). Real random codes + SMS in LIVE mode.
DEMO_OTP_CODE=222222

# Secrets — in production each must be 32+ random characters (the API refuses to start otherwise).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_SECRET=change-me-otp-secret
WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_SECRET=change-me-payment-secret

# Authentication (Passport.js) — customer and staff sessions use DIFFERENT secrets
JWT_SECRET=change-me-customer-jwt-secret
JWT_ADMIN_SECRET=change-me-admin-jwt-secret
CUSTOMER_SESSION_DAYS=30
ADMIN_SESSION_HOURS=12
# Leave empty on localhost. In production, e.g. .ruposhi.com.bd if the API runs on a sub-domain.
COOKIE_DOMAIN=

# Meta Conversions API (server-side tracking). Empty = dry-run (events are logged, not sent)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# GA4 Measurement Protocol. Empty = dry-run
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# SMS gateway (BD) — empty = demo (logged only)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=RUPOSHI

# Courier APIs — empty = demo
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
REDX_API_TOKEN=

# bKash / SSLCommerz — empty = demo sandbox simulation
BKASH_APP_KEY=
BKASH_APP_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Cloudinary — image uploads from the admin (products, categories, homepage). Empty = paste image URLs only.
# Dashboard → Settings → API Keys. Never share the API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ruposhi

# Shared with the storefront (same value in client env). Lets the Next.js proxy pass on each visitor's real IP,
# so rate limits work per shopper on Vercel. 32+ chars. Leave empty for local development.
PROXY_SECRET=
